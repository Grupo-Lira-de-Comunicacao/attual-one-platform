# local mantém o MVP homologado. Use supabase somente após configurar o projeto.
NEXT_PUBLIC_DATA_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Variáveis somente de servidor. Nunca prefixar com NEXT_PUBLIC_.
ALLOW_PUBLIC_SIGNUP=false
SUPABASE_SERVICE_ROLE_KEY=

# Integração inbound com o Casting Attual 360.
# Use o mesmo valor configurado no Casting como ATTUAL_ONE_INTEGRATION_SECRET.
ATTUAL_ONE_INTEGRATION_SECRET=
